# Copy this file to .env and fill in the values. Never commit .env.

# NASA Earthdata Login token (https://urs.earthdata.nasa.gov -> Generate Token).
# Only used by one-off data download scripts. The published app does not use it.
EARTHDATA_TOKEN=

# Gemini key for the free-text assistant. Without it the app offers the guided questions only.
GEMINI_API_KEY=

# Front-end origin allowed by the back-end (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Back-end URL used by the front-end
NEXT_PUBLIC_API_URL=http://localhost:8000
