# Copia questo file in .env e inserisci i valori. Il file .env non va mai in un commit.

# Token NASA Earthdata Login (https://urs.earthdata.nasa.gov → Generate Token).
# Serve solo agli script che scaricano dati una volta (Giovanni). L'app pubblicata non lo usa.
EARTHDATA_TOKEN=

# Chiave Gemini per l'assistente a domanda libera. Senza chiave l'app usa le domande guidate.
GEMINI_API_KEY=

# Origine del front-end ammessa dal back-end (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Indirizzo del back-end usato dal front-end
NEXT_PUBLIC_API_URL=http://localhost:8000
